# Скопируйте в .env и заполните. .env не попадает в git.

PORT=8080
# development | production
ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sadaka?sslmode=disable

# В production обязателен, не короче 32 символов.
JWT_SECRET=

# Разрешённые origin фронтенда через запятую. "*" — только для разработки.
CORS_ORIGINS=*

# mock — тестовые платежи (запрещён в production). Alif / IMON — позже.
PAYMENT_PROVIDER=mock

# Савоб: множитель и событие (regular, ramadan, kurban, special_event).
# Рамадан: SAVOB_MULTIPLIER=2 SAVOB_EVENT=ramadan
SAVOB_MULTIPLIER=1
SAVOB_EVENT=regular

# Первый суперадмин Комитета улемов (создаётся, только если админов ещё нет).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Администратор Комитета
